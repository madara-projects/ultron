# ---------------------------------------------------------------------------
# Ultron server (backend/). All optional; the defaults are shown.
# Copy to .env for local use. .env is git-ignored; never commit real values.
# ---------------------------------------------------------------------------

# Where account data comes from. Only "fixture" (sample data) exists so far.
# ULTRON_DATA_SOURCE=fixture

# Used only when running without Docker (`python -m backend`). Keep 127.0.0.1;
# other values expose Ultron to your network.
# ULTRON_HOST=127.0.0.1
# ULTRON_PORT=8765
# Host port used by `docker compose` (the container always listens on 8765).
# ULTRON_HOST_PORT=8765

# ULTRON_QUOTE_CURRENCY=INR
# Prices older than this are flagged as stale and make totals incomplete.
# ULTRON_PRICE_STALE_AFTER_SECONDS=300

# Fee assumptions for estimates. Giottus fees depend on rolling trade volume;
# re-check the published fee schedule and update these when it changes.
# ULTRON_FEE_INR_PAIR_PCT=0.4
# ULTRON_FEE_CRYPTO_PAIR_PCT=0.3
# ULTRON_FEE_GST_PCT=18
# ULTRON_FEE_REVIEWED_ON=2026-09-25
